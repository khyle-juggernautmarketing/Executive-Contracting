# n8n lead webhook (server-side only — never expose in client code)
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/your-id

# JWT secret configured in n8n webhook JWT auth (HS256)
N8N_JWT_SECRET=your-jwt-secret-here

# Optional: Upstash/Vercel KV for shared appointment blocking in production
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Protects /api/cron/flush-pending (Vercel Cron also sends x-vercel-cron)
# CRON_SECRET=generate-a-long-random-string
